# ==============================================================================
# SUPABASE PROJECT 1: CONTENT DATABASE (Reusable Media Catalog / Headless CMS)
# ==============================================================================
NEXT_PUBLIC_CONTENT_SUPABASE_URL=https://your-content-project.supabase.co
NEXT_PUBLIC_CONTENT_SUPABASE_ANON_KEY=eyJ...your-content-anon-key...
# Service role key is server-only (used for admin writes / migration seed scripts)
CONTENT_SUPABASE_SERVICE_ROLE_KEY=eyJ...your-content-service-role-key...

# ==============================================================================
# SUPABASE PROJECT 2: USER & ENGAGEMENT DATABASE (DramaShort App Specific)
# ==============================================================================
NEXT_PUBLIC_USER_SUPABASE_URL=https://your-user-project.supabase.co
NEXT_PUBLIC_USER_SUPABASE_ANON_KEY=eyJ...your-user-anon-key...
USER_SUPABASE_SERVICE_ROLE_KEY=eyJ...your-user-service-role-key...

# ==============================================================================
# PAYMENTS & MONETIZATION (Step 1 & Step 6 Security Controls)
# ==============================================================================
# Webhook signature verification secret (Required in production)
PAYMENT_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Simulated checkout flag (Set to "true" ONLY in local dev/tests to test coin flows without payment)
# MUST be false or unset in production environments.
ENABLE_SIMULATED_CHECKOUT=false

# Optional hosted payment provider credentials (e.g. Stripe Checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ==============================================================================
# CRON & BACKGROUND AUTOMATION (Step 8 Authorization)
# ==============================================================================
# Secret token for Vercel Cron / scheduled workers (Passed via Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-cron-secret-token

# ==============================================================================
# MEDIA STREAMING & PLAYBACK SIGNING (Step 10 Signed URLs)
# ==============================================================================
# Secret key used to sign short-lived playback tokens (HMAC-SHA256, 15 min TTL).
# There is no built-in default: when unset, playback URLs are returned unsigned.
PLAYBACK_SIGNING_SECRET=your-playback-signing-secret

# Set to "true" to return only signed playback URLs. Requires PLAYBACK_SIGNING_SECRET
# and a CDN/origin that verifies the token and expires query parameters.
REQUIRE_SIGNED_PLAYBACK=false

# ==============================================================================
# ADMIN DRAFT PREVIEW LINKS (Task 16.4)
# ==============================================================================
# Secret used to sign 1-hour preview links for unpublished dramas. Optional: when
# unset, the User DB service role key is used. There is no built-in default.
PREVIEW_SECRET=your-preview-signing-secret

# ==============================================================================
# OBSERVABILITY & RATE LIMITING (Step 9 Serverless Rate Limiting)
# ==============================================================================
# Optional Upstash Redis credentials for distributed multi-region rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
