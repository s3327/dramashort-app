{
  "name": "dramashort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop --no-backup",
    "db:push": "supabase db push",
    "types": "supabase gen types typescript --linked --schema public > types/supabase.ts",
    "db:seed:dev": "tsx scripts/seed-dev-content.ts",
    "db:clean:dev": "tsx scripts/seed-dev-content.ts --clean",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --require ./scripts/test/stub-server-only.cjs --test \"__tests__/**/*.test.ts\"",
    "test:file": "tsx --require ./scripts/test/stub-server-only.cjs --test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:audit": "node scripts/ci/audit-gate.mjs",
    "analyze": "node -e \"process.env.ANALYZE='true'; const { execSync } = require('child_process'); execSync('next build', { stdio: 'inherit' });\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "supabase": "^2.118.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
