{
  "name": "dramashort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:content:push": "supabase db push --workdir supabase/content",
    "db:user:push": "supabase db push --workdir supabase/user",
    "types:content": "supabase gen types typescript --project-id czkkzoiuyqybafacpgsp > types/supabase-content.ts",
    "types:user": "supabase gen types typescript --project-id bpidsbcrvpkavvdvtpgh > types/supabase-user.ts",
    "types:all": "npm run types:content && npm run types:user",
    "db:seed:dev": "tsx scripts/seed-dev-content.ts",
    "db:clean:dev": "tsx scripts/seed-dev-content.ts --clean",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test \"__tests__/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "supabase": "^2.118.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
